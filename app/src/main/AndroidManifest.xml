<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="false" />

    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      Read-only BYD permissions, mirroring the set DiPlus declares for the devices
      this app reads. DiPlus is a self-signed third-party APK (CN=vanjoge) with no
      sharedUserId, so whatever it can read is reachable by declaration alone: it
      never uses ADB or a privileged daemon. It declares 120 BYD permissions; this
      app previously declared 10, which is the difference actually under test.

      GET/COMMON only, deliberately: DriveApex is a read-only telemetry consumer and
      must never hold a _SET permission (see the safety boundary below).
    -->
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_SPEED_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENGINE_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_MOTOR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_ENERGY_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_GEARBOX_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_VEHICLE_DATA_GET" />
    <!-- The vehicle log showed the fast-changing drivetrain values arriving on
         BYDAutoStatisticDevice and BYDAutoInstrumentDevice, neither of which this
         app had ever declared a permission for. -->
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_STATISTIC_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_INSTRUMENT_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_BODYWORK_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_SENSOR_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_COMMON" />
    <uses-permission android:name="android.permission.BYDAUTO_CHARGING_GET" />
    <uses-permission android:name="android.permission.BYDAUTO_POWER_GET" />

    <!--
      android:process="com.byd.warning" was set here on the theory that the HAL
      allowlists client processes by name. Measurement on the vehicle removed
      the reason for it and gave a reason against it.

      Against the theory: DiPlus turns out to hold only BYDAUTO_ENGINE_COMMON
      and BYDAUTO_SPEED_COMMON, exactly this app's tier, installed to /data/app
      with no SYSTEM or PRIVILEGED flag - so nothing about its identity explains
      what it can read, and its API is served by a native process rather than by
      the Java HAL listener this attribute was meant to imitate.

      Against the attribute: curl from the shell UID to 127.0.0.1:8988 on the
      vehicle returns the value, while every request from inside this app to the
      same address is met with a TCP reset. A per-process or per-UID network
      rule rejecting with RST produces exactly that, and borrowing another
      vendor app's process name is a plausible way to land in one.
    -->
    <application
        android:name=".DriveApexApplication"
        android:allowBackup="true"
        android:label="DriveApex"
        android:supportsRtl="true"
        android:theme="@style/Theme.DriveApex">
        <activity
            android:name=".MainActivity"
            android:screenOrientation="unspecified"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".SettingsActivity"
            android:label="DriveApex Settings"
            android:screenOrientation="unspecified"
            android:exported="false" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>

</manifest>
